# Copy to .env and fill in from Supabase: Project Settings -> API
#
# EXPO_PUBLIC_ vars are embedded in the app bundle and are readable by anyone
# who has the app. Use the publishable/anon key ONLY.
# NEVER put the service_role key here -- it bypasses Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
